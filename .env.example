# Docker deployment: host paths and published endpoint
MCP_WORKSPACE_HOST_PATH=..
MCP_BIND_HOST=127.0.0.1
MCP_CONTAINER_NAME=writing-workspace-mcp

# Server
MCP_SERVER_NAME=Writing Workspace MCP
MCP_PORT=8765
MCP_PATH=/mcp

# Workspace layout
MCP_SKILLS_DIRNAME=skills
MCP_DRAFT_DIRNAME=draft
MCP_TASKS_DIRNAME=.mcp-tasks

# Diff page and Git
MCP_DRAFT_COMMIT_PASSWORD=change-this-password
MCP_GIT_LOCALE=C.utf8
MCP_GIT_WORD_DIFF_REGEX=[[:alnum:]_]+|[^[:space:]]
MCP_DRAFT_HISTORY_LIMIT=20

# Synchronous execution and file limits
MCP_DEFAULT_TIMEOUT=30
MCP_MAX_TIMEOUT=120
MCP_MAX_OUTPUT_CHARS=50000
MCP_MAX_READ_CHARS=200000
MCP_MAX_PATCH_CHARS=2000000

# Background tasks
MCP_DEFAULT_BACKGROUND_TIMEOUT=21600
MCP_MAX_BACKGROUND_TIMEOUT=86400
MCP_TASK_LOG_TAIL_CHARS=10000
MCP_EXECUTION_HOME=
MCP_RESTART_DELAY=2

# Direct Python execution only: uncomment and use host paths.
# Compose intentionally keeps these three values container-internal.
# MCP_PROJECT_ROOT=/absolute/path/to/mymcp
# MCP_WORKSPACE_ROOT=/absolute/path/to/workspace
# MCP_HOST=127.0.0.1
# MCP_DRAFT_DIFF_PAGE=/absolute/path/to/draft_diff.html
