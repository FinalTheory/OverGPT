# Keep this file shell-compatible as well as Docker-Compose-compatible: Makefile
# sync/doctor targets source .env directly. Quote values containing spaces or shell
# metacharacters (single quotes are safest for passwords).

# Docker deployment: host workspace and container identity.
MCP_WORKSPACE_HOST_PATH=..
MCP_PROJECT_RELATIVE_PATH=mymcp
MCP_UID=1000
MCP_GID=1000
MCP_SERVER_NAME='OverGPT'

# Diff write actions. Change this before exposing the service beyond localhost.
MCP_DRAFT_COMMIT_PASSWORD='change-this-password'

# Optional remote source sync used by `make sync-down` / `make sync-up`.
# Leave both host and directory empty to disable remote sync.
MCP_SYNC_HOST=
MCP_SYNC_PORT=22
MCP_SYNC_REMOTE_DIR=

# Optional additional bind mount. Uncomment all four lines to enable it.
# COMPOSE_FILE=compose.yaml:compose.additional.yaml
# MCP_ADDITIONAL_HOST_PATH=/absolute/host/path
# MCP_ADDITIONAL_CONTAINER_PATH=/opt/additional
# MCP_ADDITIONAL_READ_ONLY=true

# Optional ChatGPT Web automation. A VPS should normally use bundled Chromium.
MCP_CHATGPT_AUTOMATION_ENABLED=false
# ChatGPT app/plugin name selected with @mention before automated sends.
MCP_APP_NAME=OverGPT
# MCP_CHATGPT_BROWSER_CHANNEL=chrome
# MCP_CHATGPT_BROWSER_EXECUTABLE=/absolute/path/to/Google Chrome
# MCP_CHATGPT_BROWSER_NO_SANDBOX=false
MCP_CHATGPT_BROWSER_HEADLESS=false

# Optional deployment overrides; built-in defaults are usually sufficient.
# MCP_BIND_HOST=127.0.0.1
# MCP_PORT=8765
# MCP_MEMORY_LIMIT=4g
# MCP_CPU_LIMIT=2.0
# MCP_VNC_BIND_HOST=127.0.0.1
# MCP_VNC_PORT=6080
# MCP_VNC_GEOMETRY=1440x900x24

# Direct Python execution only: uncomment machine-specific paths as needed.
# MCP_WORKSPACE_ROOT=/absolute/path/to/workspace
# MCP_ADDITIONAL_ROOT=/absolute/path/to/additional-data
# MCP_EXECUTION_HOME=/absolute/path/to/execution-home
